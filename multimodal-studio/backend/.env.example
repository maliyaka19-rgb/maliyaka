# backend/.env.example - Environment Configuration Template

# === Application Settings ===
ENVIRONMENT=development  # development|production|testing
DEBUG=True  # True|False
API_V1_STR=/api/v1

# === Server Configuration ===
HOST=0.0.0.0
PORT=8000
WORKERS=1  # Increase for production: e.g., 4

# === API Keys (Obtain from respective providers) ===
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key-here

# Stability AI / DALL-E 3 Key  
STABILITY_API_KEY=your-stability-key-here

# Google AI / Veo Key
GOOGLE_AI_KEY=your-google-ai-key-here

# === Database Configuration ===
POSTGRES_DB=multimodal_studio
POSTGRES_USER=appuser
POSTGRES_PASSWORD=secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Cache Configuration ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# === CORS Settings (Comma-separated origins) ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Security ===
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Feature Flags ===
ENABLE_CODE_GENERATION=true
ENABLE_VISUAL_PROMPTS=true
ENABLE_VIDEO_PROMPTS=true

# === Yerel Model Yedekliligi (opsiyonel, VARSAYILAN KAPALI) ===
# Bulut saglayicilar tukendiginde kullanilacak OpenAI-uyumlu yerel sunucu.
# Guvenlik: yalnizca loopback (127.0.0.1 / localhost) adresleri kabul edilir.
# Ollama ornegi:  ollama serve  +  ollama pull qwen2.5:1.5b
# NEXUS_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# NEXUS_LOCAL_LLM_MODEL=qwen2.5:1.5b
# LM Studio icin:  NEXUS_LOCAL_LLM_URL=http://127.0.0.1:1234/v1
NEXUS_LOCAL_LLM_URL=
NEXUS_LOCAL_LLM_MODEL=